@code {
    private SfSidebar SidebarObj;
    private SidebarType SidebarType = SidebarType.Push;
    private string lastCategory = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("registerDebouncedResizeCallback", dotNetRef);
            int width = await JS.InvokeAsync<int>("eval", "window.innerWidth");
            await HandleResizeCategoryChange(width <= 800 ? "mobile" : "desktop");
        }
    }

    [JSInvokable]
    public async Task OnResizeCategoryChanged(string category)
    {
        await HandleResizeCategoryChange(category);
    }
    private async Task HandleResizeCategoryChange(string category)
    {
        if (category == lastCategory)
            return;

        lastCategory = category;

        var newType = category == "mobile" ? SidebarType.Over : SidebarType.Push;

        // Change sidebar type if needed
        if (SidebarType != newType)
        {
            SidebarType = newType;
            await InvokeAsync(StateHasChanged);
            await Task.Yield(); // Allow Blazor to update the UI
        }

        // Ensure sidebar opens on desktop
        if (category == "desktop")
        {
            SidebarToggle = true; //  Make sure it's open
            await InvokeAsync(StateHasChanged);
            await Task.Delay(10); // Optional for layout stability
        }
        else
        {
            SidebarToggle = false;
            await InvokeAsync(StateHasChanged);
        }
    }


    private void HandleRenderDayCell(RenderDayCellEventArgs args)
    {
        if (args.IsOutOfRange!=null && !args.IsOutOfRange)
        {
            var bookedDates = new List<CheckInOut>();

            foreach (var hotel in AllHotels)
            {
                if (hotel.CheckInOut != null)
                {
                    bookedDates.AddRange(hotel.CheckInOut);
                }
            }

            var isBooked = bookedDates.Any(d =>
            {
                var checkIn = d.CheckIn.Date;
                var checkOut = d.CheckOut.Date;
                return args.Date.Date >= checkIn && args.Date.Date <= checkOut;
            });
            string newClassList = args.CellData.ClassList;
            string additionalClass = isBooked ? "e-date-cell-orange" : "e-date-cell-green";

            // Make sure to handle spacing properly
            args.CellData.ClassList = string.IsNullOrWhiteSpace(newClassList)
                ? additionalClass
                : $"{newClassList} {additionalClass}";
        }

    }

